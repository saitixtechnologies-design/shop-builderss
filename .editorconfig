# Same basic formatting in every editor (VS Code: install the "EditorConfig" extension).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md}]
indent_size = 2

[frontend/*.{js,css,html}]
indent_size = 2
