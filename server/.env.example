# Copy to .env for local development. On Render, add the same keys under Environment.
PORT=5001
NODE_ENV=development

# SQL Server (works on Windows, Linux and macOS; no ODBC driver needed)
DB_SERVER=
DB_PORT=1433
DB_DATABASE=
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=Yes
# Yes only if your host uses a self-signed certificate (shared hosts often do)
DB_TRUST_CERTIFICATE=No

# Sign-in tokens: a long random value (64+ characters), e.g. from
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Email for password-reset codes
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=Shop Builder
MAIL_FROM_ADDRESS=

# Production only: sites allowed to call the API (admin panel and storefront), comma-separated
CORS_ORIGINS=
# Number of proxies in front of the API (Render = 1)
TRUST_PROXY=1

# Shop web addresses (see docs/DOMAINS.md)
# Your main domain: every shop also opens on <shop-slug>.PLATFORM_DOMAIN
PLATFORM_DOMAIN=
# Optional: add shops' own domains to the storefront's Vercel project automatically
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
