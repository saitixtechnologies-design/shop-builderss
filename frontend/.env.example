# Copy to .env (local) or set the same keys in your hosting panel (Vercel / Render / Hostinger).
# The API's address, no trailing slash. Leave empty to use http://localhost:5001 on your computer.
SHOP_API_URL=
# Your main domain (every shop also opens on <shop-slug>.PLATFORM_DOMAIN). Leave empty to turn this off.
PLATFORM_DOMAIN=
# Port for the local / Node storefront server
FRONTEND_PORT=5174
